# =============================================================================
# Oráculo das Conexões Narrativas — variáveis de ambiente
# Copie para `.env` e ajuste. NENHUMA variável é obrigatória:
# sem configuração de LLM, o app roda em modo local (demonstração).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Provedor de LLM
# -----------------------------------------------------------------------------
# zai    → SDK z-ai-web-dev-sdk (exige .z-ai-config; comportamento original)
# openai → qualquer endpoint compatível com Chat Completions
# local  → força o motor hermenêutico determinístico (sem chamadas externas)
# Deixe vazio para auto-detecção.
ORACLE_LLM_PROVIDER=

# Para ORACLE_LLM_PROVIDER=openai (OpenAI, Groq, Together, DeepSeek,
# OpenRouter, Ollama, vLLM, LM Studio...):
ORACLE_LLM_BASE_URL=
# ex.: https://api.openai.com/v1   |  http://localhost:11434/v1
ORACLE_LLM_API_KEY=
ORACLE_LLM_MODEL=
# ex.: gpt-4o-mini  |  llama-3.3-70b-versatile  |  llama3.1:8b

# -----------------------------------------------------------------------------
# 2. Persistência
# -----------------------------------------------------------------------------
# prisma → exige DATABASE_URL + `npm run db:push` + `npm run db:generate`
# file   → JSON em disco (sem dependências nativas)
# Deixe vazio para auto-detecção (Prisma quando DATABASE_URL existir e o
# schema estiver aplicado; senão, arquivo).
ORACULO_STORE=

DATABASE_URL="file:../db/custom.db"

# Diretório do armazenamento em arquivo (padrão: ./.data)
ORACULO_DATA_DIR=./.data

# -----------------------------------------------------------------------------
# 3. Observações
# -----------------------------------------------------------------------------
# - `.data/` e `*.db` estão no .gitignore.
# - NUNCA comite chaves de API.
# - Para verificar o motor ativo: GET /api/status
